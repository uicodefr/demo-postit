<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>log/postit.log</file>
        
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>log/postit.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <springProfile name="default">
        <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!-- standard pattern for developers -->
                <pattern>%d{dd-MM HH:mm:ss.SSS} [%t] %5p %c{4}:%L %m%n</pattern>
            </encoder>
        </appender>
        <root level="info">
            <appender-ref ref="stdout"/>
        </root>
    </springProfile>

    <springProfile name="!default">
        <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!-- pattern for writing log with stacktrace in one line -->
                <pattern>%d{dd-MM HH:mm:ss.SSS} [%t] %5p %c{4}:%L %replace(%m - %ex{100}){'[\r\n\t]+', ' '}%nopex%n</pattern>
            </encoder>
        </appender>
        <root level="info">
            <appender-ref ref="stdout"/>
            <appender-ref ref="FILE" />
        </root>
    </springProfile>

</configuration>